---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  padding?: 'default' | 'none'
  variant?: 'default' | 'bordered'
}

const {
  padding = 'default',
  variant = 'default',
  class: className = '',
  ...rest
} = Astro.props
---

<div
  class:list={[
    'rounded-xl',
    padding === 'default' && 'p-6',
    variant === 'bordered' && 'border',
    className
  ]}
  {...rest}
>
  <slot />
</div>
